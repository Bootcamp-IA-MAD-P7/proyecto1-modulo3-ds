# F5 RiskAI — entorno (ejemplo). Copia este archivo como `.env` y ajusta los
# valores. NUNCA subas `.env` al repositorio (está en .gitignore).
#
# Los valores que aparecen aquí son solo ejemplos de desarrollo, no credenciales
# reales. El despliegue en Render inyecta DATABASE_URL y CORS_ORIGINS
# automáticamente; no hace falta commitear nada.

# ---------------------------------------------------------------------------
# Backend (FastAPI) — backend/database.py y backend/main.py
# ---------------------------------------------------------------------------

# Cadena SQLAlchemy. Para Docker Compose debe apuntar al servicio `postgres`:
#   postgresql+psycopg://usuario:password@postgres:5432/f5_riskai
# Para desarrollo local sin Docker puede apuntar a una instancia local.
DATABASE_URL=postgresql+psycopg://riskai:riskai_dev_password@postgres:5432/f5_riskai

# Orígenes permitidos por CORS (separados por comas). En Docker el frontend
# se sirve en http://localhost:8080. En Render, la URL pública del frontend.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend (Vue 3 + Vite) — frontend/.env.local (variable de BUILD de Vite)
# ---------------------------------------------------------------------------

# URL base de la API que el navegador usará (se hornea en el bundle al
# ejecutar `npm run build`). En Render: https://<api>.onrender.com
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Docker Compose — interpolación de docker-compose.yml (solo dev local)
# ---------------------------------------------------------------------------

POSTGRES_USER=riskai
POSTGRES_PASSWORD=riskai_dev_password
POSTGRES_DB=f5_riskai

# Puerto del frontend en la máquina host.
FRONTEND_PORT=8080