# F5 RiskAI — variables de entorno (copiar a .env y ajustar; NUNCA commitear credenciales reales).

# Cadena de conexión PostgreSQL (Render la inyecta automáticamente).
# Formato propio de psycopg v3: postgresql+psycopg://usuario:password@host:puerto/base
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/f5_riskai

# Orígenes permitidos por CORS (separados por coma). En Render usa la URL del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL base de la API para el frontend (en el servicio web de Render).
VITE_API_URL=http://127.0.0.1:8000